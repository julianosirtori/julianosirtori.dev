# Copy to .env.local for local use. Use separate values in Vercel Preview/Production.
NEXT_PUBLIC_LOCAL_DOMAIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
# Generate independent 32+ character random secrets. Never use NEXT_PUBLIC_ for these.
BETTER_AUTH_SECRET=
NEWSLETTER_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=
RESEND_API_KEY=
NEWSLETTER_FROM=Notas do Juliano <website@julianosirtori.dev>
RESEND_SEGMENT_PT=
RESEND_SEGMENT_EN=
RESEND_WEBHOOK_SECRET=
# Required in Vercel Preview: exact test addresses, comma-separated. Keep private.
# Leave empty in Production to accept public subscriptions.
NEWSLETTER_ALLOWED_EMAILS=
# Separate persistent quotas; reserve extra provider capacity for retries/broadcasts.
NEWSLETTER_DAILY_LIMIT=80
NEWSLETTER_MONTHLY_LIMIT=2400
CONTACT_DAILY_LIMIT=20
CONTACT_MONTHLY_LIMIT=600
# Enable only in production after disabling automatic/enhanced GA measurement.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Numeric Property ID for the local GA4 administration script (not G- measurement ID).
GA4_PROPERTY_ID=
